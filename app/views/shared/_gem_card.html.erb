
<div class="mx-auto">
  <!-- IMAGE -->
  <div class="img-container">
    <img src="https://media.gettyimages.com/id/2228622605/photo/charming-parisian-street-with-historic-architecture-and-view-of-institut-de-france-paris.jpg?s=612x612&w=0&k=20&c=6OTBWuiUUKt6kdyWlbpjJ5ax7SDOPhV1SsoSHBVftGg="
          alt="Image complétement VRAIE de <%= gem[:title] %>"
          onerror="this.style.display='none'">

    <!-- Image overlay -->
    <div class="img-overlay"></div>

    <!-- Category badge -->
    <div class="category-badge">
      <span></span>
      <%= gem[:category] %>
    </div>
  </div>


  <!-- CONTENT -->
  <div class="content">
    <!-- LOCATION -->
    <div class="content-location">
      <i class="fa-solid fa-location-dot"></i>
      <%= gem[:address] %>
    </div>
    <!-- TITLE -->
    <h2><%= gem[:title] %></h2>
    <!-- ORANGE ACCENT -->
    <div class="separator"></div>
    <!-- DESCRIPTION -->
    <p><%= gem[:description] %></p>
  </div>

</div>
