
<div class="favs-page">

  <% if @favs.any? %>

    <div class="favs-stack">

      <% @favs.each do |fav| %>

        <details class="favs-wallet-details">

          <%# OVERVIEW - CARD FERMÉE %>
          <summary
            class="favs-wallet-summary"
            style="background-image: linear-gradient(rgba(10, 20, 35, 0.45), rgba(10, 20, 35, 0.65)), url('<%= fav.image_url %>');"
          >

            <div class="wallet-summary-content">

              <div class="wallet-category">
                <span></span>
                <%= fav.category %>
              </div>

              <h2><%= fav.title %></h2>

              <div class="wallet-address">
                <i class="fa-solid fa-location-dot"></i>
                <%= fav.address %>
              </div>

            </div>

          </summary>

          <%# ACTIONS - TOUJOURS AU MEME ENDROIT %>
          <div class="favs-card-actions">

            <%# DELETE %>
            <%= button_to fav_path(fav),
                  method: :delete,
                  class: "fav-delete",
                  form: { class: "fav-delete-form" },
                  aria: { label: "Supprimer ce favori" } do %>
              <i class="fa-solid fa-trash"></i>
              <span class="fav-delete-label">Supprimer cette carte</span>
            <% end %>

            <%# TOGGLE %>
            <button
              type="button"
              class="wallet-toggle"
              aria-label="Développer ou réduire"
              onclick="
                const card = this.closest('.favs-wallet-details');
                card.open = !card.open;
              "
            >
              <i class="fa-solid fa-chevron-down wallet-chevron-down"></i>
              <i class="fa-solid fa-chevron-up wallet-chevron-up"></i>
            </button>

          </div>

          <%# FULL CARD %>
          <div class="favs-expanded-content">
            <%= render "shared/gem_card", gem: fav %>
          </div>

        </details>

      <% end %>

    </div>

  <% else %>

    <div class="favs-empty">
      <p>You haven't saved any gems yet.</p>
    </div>

  <% end %>

</div>
