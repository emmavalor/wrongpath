<div class="chat-page">
  <div class="chat-box">
    <div class="chat-messages" id="messages">
      <% @chat.messages.where(to_display: [true, nil]).each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>
    </div>
  </div>


  <div class="new_message_container">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>


