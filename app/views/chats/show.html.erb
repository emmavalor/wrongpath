<div class="chat-page">
  <div class="chat-box">
    <div class="chat-messages" id="messages">
      <% @chat.messages.where(to_display: [true, nil]).each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>

      <template id="user_message">
        <div class="message-container container-user">
          <div class="message message-user">
            <p>Coucou c'est le user</p>
          </div>
          <%= image_tag "Emma.jpeg", alt: "Description de l'image", class:"avatar" %>
        </div>
      </template>

      <template id="assistant_message">
        <div class="message-container">
          <%= image_tag "wrongpath_logo_text.png", alt: "Description de l'image", class:"avatar" %>
          <div class="message message-assistant">
            <p>Coucou c'est l assistant</p>
          </div>
        </div>
      </template>

    </div>
  </div>


  <div id="new_message_container">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>
