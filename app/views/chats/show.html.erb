<div class="chat-page">
  <div class="chat-header">
    <h1>WrongPath</h1>
    <p>Your secret guide to Paris</p>
  </div>

  <div class="chat-box">
    <div class="chat-messages">
      <% @chat.messages.order(:created_at).each do |message| %>
        <div class="message message-<%= message.try(:role) || "assistant" %>">
          <%= raw(render_markdown(message.content)) %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="category-buttons">
    <% Chat::CATEGORIES.each do |category| %>
      <%= button_to category, chat_messages_path(@chat),
            params: { message: { content: category } },
            class: "btn btn-category" %>
    <% end %>
  </div>

  <%= simple_form_for [@chat, @message], html: { class: "chat-form" } do |f| %>
    <%= f.input :content, as: :string, label: false,
          placeholder: "Say something here...",
          wrapper_html: { class: "chat-input" } %>
    <%= f.button :submit, "Send", class: "btn-send" %>
  <% end %>
</div>
