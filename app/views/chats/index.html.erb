
<div id="homepage-container">

    <div data-controller="map" data-map-api-key-value="<%= ENV['MAPBOX_KEY'] %>" id="map-container"></div>


  <div id="address-container">
    <%= form_with url: chats_path, class: "my-2", data: { turbo: false } do |form| %>
      <%#= form.label :address, "City", class: "visually-hidden" %>
      <%= form.text_field :address, class: "input mb12 bg-white", autocomplete: "address-line1", placeholder: "Address" %>

      <%= form.text_field :city, class: "input mb12 bg-white visually-hidden", autocomplete: "address-level2", placeholder: "City" %>
      <%= form.text_field :zipcode, class: "input mb12 bg-white visually-hidden", autocomplete: "postal-code", placeholder: "ZIP / Postcode" %>
      <%= form.text_field :country, class: "input mb12 bg-white visually-hidden", autocomplete: "country-name", placeholder: "Country" %>

      <%= form.submit "Unveil secrets !", class: "btn-wrongpath mt-2 w-100" %>
    <% end %>
  </div>

</div>


<script>

  const ACCESS_TOKEN = '<%= ENV['MAPBOX_KEY'] %>';
  window.addEventListener('load', () => {

      const collection = mapboxsearch.autofill({
          accessToken: ACCESS_TOKEN
      });
  });

</script>
