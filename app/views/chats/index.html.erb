
<link href="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.js"></script>

<div id="homepage-container" data-controller="autofill">

  <div id="map-container">
    <div id="map"></div>
  </div>

  <div id="address-container">
    <%= form_with url: chats_path, class: "my-2", data: { turbo: false } do |form| %>
      <%= form.label :address, "City", class: "visually-hidden" %>
      <%= form.text_field :address, id: "input-hidden", class: "input mb12 bg-white visually-hidden", autocomplete: "address-line1", placeholder: "Address" %>

      <%= form.submit "Unveil secrets !", class: "btn-wrongpath mt-2 w-100" %>
    <% end %>
  </div>

</div>


<script>

  const ACCESS_TOKEN = '<%= ENV['MAPBOX_KEY'] %>';

    const map = new mapboxgl.Map({
        accessToken: ACCESS_TOKEN,
        container: 'map',
        center: [12.99209, 40.68933],
        zoom: 1
    });

    window.addEventListener('load', () => {
        const searchBox = new MapboxSearchBox();
        searchBox.accessToken = ACCESS_TOKEN;
        searchBox.options = {
            types: 'address,poi',
            proximity: [2.00000, 49.00000]
        };

        searchBox.marker = true;
        searchBox.mapboxgl = mapboxgl;
        searchBox.componentOptions = { allowReverse: true, flipCoordinates: true };
        map.addControl(searchBox);
        console.log('map lancée')
        console.log(searchBox)

        searchBox.addEventListener('retrieve', (e) => {
            const feature = e.detail.features[0];
            if (!feature) return;
            const adresseComplete = feature.properties.full_address;
            inputHidden = document.getElementById('input-hidden');
            inputHidden.value = adresseComplete;
            console.log(inputHidden);
        });
    });


</script>
